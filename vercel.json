{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": null,
  "buildCommand": "bash tools/vercel-build.sh",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/godot/chunks/(.*)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    }
  ]
}
