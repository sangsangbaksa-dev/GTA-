{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash tools/vercel-build.sh",
  "outputDirectory": "web/dist",
  "headers": [
    {
      "source": "/godot/(.*)\\.(wasm|pck|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/godot/chunks/chunk_(.*)\\.scn",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
