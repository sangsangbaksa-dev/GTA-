<Project Sdk="Godot.NET.Sdk/4.4.1">
  <!-- Engine layer. May reference Godot and Harbor.Core; Harbor.Core must never reference this. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Harbor.Game</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../core/src/Harbor.Core/Harbor.Core.csproj" />
    <EmbeddedResource Include="../data/combat/*.json" LogicalName="data/combat/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../data/weapons/*.json" LogicalName="data/weapons/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../data/vehicles/calloway_compact.json" LogicalName="data/vehicles/calloway_compact.json" />
    <EmbeddedResource Include="../data/world/harbor_front.json" LogicalName="data/world/harbor_front.json" />
    <EmbeddedResource Include="data/missions/harbor_lockdown.json" LogicalName="data/missions/harbor_lockdown.json" />
  </ItemGroup>
</Project>
