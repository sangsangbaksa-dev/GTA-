{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "map",
  "type": "object",
  "properties": {
    "bounds": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "spawn": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "roads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "to": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "width": {
            "type": "number"
          }
        },
        "required": [
          "from",
          "to"
        ]
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "district": {
            "type": "string"
          },
          "rect": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset": {
            "type": "string"
          },
          "pos": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "rot": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        },
        "required": [
          "asset",
          "pos"
        ]
      }
    }
  },
  "required": [
    "bounds",
    "placements"
  ]
}