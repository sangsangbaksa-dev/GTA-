{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "harbor-streaming",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "chunkSizeMeters": { "type": "number", "exclusiveMinimum": 0 },
    "loadRadiusChunks": { "type": "integer", "minimum": 0 },
    "unloadPaddingChunks": { "type": "integer", "minimum": 0 },
    "lookaheadSeconds": { "type": "number", "minimum": 0 }
  },
  "required": [
    "chunkSizeMeters",
    "loadRadiusChunks",
    "unloadPaddingChunks",
    "lookaheadSeconds"
  ]
}
