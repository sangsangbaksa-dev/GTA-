{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harbor Lockdown encounter",
  "type": "object",
  "required": ["playerWeapon", "playerSecondary", "enemyWeapon", "initialArmor", "playerReserveMagazines",
    "enemyHealth", "enemySpeed", "enemyShotInterval", "enemyStartDelay", "enemyHoldDistance",
    "reinforcementDelay", "firstWave", "reinforcements", "start", "startRadius", "vehicle",
    "vehicleEnterRadius", "policeSpawns", "policeSpeed", "policeSightDistance", "extraction", "extractionRadius", "heat"],
  "properties": {
    "playerWeapon": { "$ref": "#/$defs/id" },
    "playerSecondary": { "$ref": "#/$defs/id" },
    "enemyWeapon": { "$ref": "#/$defs/id" },
    "initialArmor": { "type": "integer", "minimum": 0 },
    "playerReserveMagazines": { "type": "integer", "minimum": 1 },
    "enemyHealth": { "type": "integer", "minimum": 1, "maximum": 100 },
    "enemySpeed": { "$ref": "#/$defs/positive" },
    "enemyShotInterval": { "$ref": "#/$defs/positive" },
    "enemyStartDelay": { "$ref": "#/$defs/positive" },
    "enemyHoldDistance": { "$ref": "#/$defs/positive" },
    "reinforcementDelay": { "$ref": "#/$defs/positive" },
    "firstWave": { "$ref": "#/$defs/spawns" },
    "reinforcements": { "$ref": "#/$defs/spawns" },
    "start": { "$ref": "#/$defs/point" },
    "startRadius": { "$ref": "#/$defs/positive" },
    "vehicle": { "$ref": "#/$defs/point" },
    "vehicleEnterRadius": { "$ref": "#/$defs/positive" },
    "policeSpawns": { "$ref": "#/$defs/spawns" },
    "policeSpeed": { "$ref": "#/$defs/positive" },
    "policeSightDistance": { "$ref": "#/$defs/positive" },
    "extraction": { "$ref": "#/$defs/point" },
    "extractionRadius": { "$ref": "#/$defs/positive" },
    "heat": { "$ref": "heat.schema.json" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "positive": { "type": "number", "exclusiveMinimum": 0 },
    "point": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "spawns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/point" } }
  }
}
