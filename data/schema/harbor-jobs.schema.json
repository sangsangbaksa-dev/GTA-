{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harbor district jobs",
  "type": "object",
  "required": ["jobs"],
  "properties": {
    "jobs": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/job" } }
  },
  "$defs": {
    "point": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": -10000, "maximum": 10000 } },
    "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 35 },
    "job": {
      "type": "object",
      "required": ["id", "title", "briefing", "kind", "start", "radius", "timeLimit", "reward", "stages"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 48 },
        "title": { "type": "string", "minLength": 1, "maxLength": 64 },
        "briefing": { "type": "string", "minLength": 1, "maxLength": 230 },
        "kind": { "enum": ["combat", "drive"] },
        "start": { "$ref": "#/$defs/point" },
        "radius": { "$ref": "#/$defs/radius" },
        "timeLimit": { "type": "number", "exclusiveMinimum": 0, "maximum": 900 },
        "reward": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "stages": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/stage" } }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "combat" } } },
          "then": { "properties": { "stages": { "items": { "properties": { "type": { "enum": ["clear", "reach", "recover"] } } } } } },
          "else": { "properties": { "stages": { "items": { "properties": { "type": { "enum": ["checkpoint", "park"] } } } } } }
        }
      ]
    },
    "stage": {
      "type": "object",
      "required": ["type", "objective", "at", "radius"],
      "properties": {
        "type": { "enum": ["clear", "reach", "recover", "checkpoint", "park"] },
        "objective": { "type": "string", "minLength": 1, "maxLength": 120 },
        "at": { "$ref": "#/$defs/point" },
        "radius": { "$ref": "#/$defs/radius" },
        "enemies": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/point" } }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "clear" } } },
          "then": { "required": ["enemies"], "properties": { "enemies": { "minItems": 1 } } },
          "else": { "properties": { "enemies": { "maxItems": 0 } } }
        }
      ]
    }
  }
}
