{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SupplyDropConfig",
  "type": "object",
  "required": [
    "sites"
  ],
  "properties": {
    "intervalSeconds": {
      "type": "number"
    },
    "firstDropSeconds": {
      "type": "number"
    },
    "noticeSeconds": {
      "type": "number"
    },
    "openSeconds": {
      "type": "number"
    },
    "openRadius": {
      "type": "number"
    },
    "lifetimeSeconds": {
      "type": "number"
    },
    "cash": {
      "type": "integer"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "shop item ids granted to the opener"
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "district": {
            "type": "string"
          },
          "at": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    }
  }
}
