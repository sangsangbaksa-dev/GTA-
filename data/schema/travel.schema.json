{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "travel",
  "type": "object",
  "properties": {
    "cost": {
      "type": "integer"
    },
    "cooldownSeconds": {
      "type": "number"
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": [
          "id",
          "position"
        ]
      }
    }
  },
  "required": [
    "points"
  ]
}